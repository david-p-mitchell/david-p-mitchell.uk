---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { tools } from '../../data/tools.ts';
---

<BaseLayout title="Bible Reading Progress">
  <main class="max-w-5xl mx-auto px-4 py-12">
    <section class="text-center mb-12">
      <h1 class="text-4xl font-serif font-bold text-gray-900 dark:text-white mb-4">
        Tools
      </h1>

      <p class="text-gray-600 dark:text-gray-300 max-w-xl mx-auto text-lg">
        Helpful tools to support your Christian Walk/ Life.
      </p>
    </section>

    <section class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {tools.map((tool) => (
    <a
      href={tool.href}
      class="group block rounded-xl border border-gray-200 dark:border-gray-700
             bg-white dark:bg-gray-800
             p-6 shadow-sm
             transition-all duration-300
             hover:-translate-y-1
             hover:shadow-xl
             hover:border-blue-300
             dark:hover:border-blue-500"
    >
      <div
        class="flex items-center justify-center w-14 h-14 rounded-full
               bg-blue-100 dark:bg-blue-900/50
               mb-5 mx-auto
               text-2xl"
      >
        {tool.icon}
      </div>

      <h2
        class="text-xl font-semibold text-gray-900 dark:text-white
               text-center mb-3
               group-hover:text-blue-600
               dark:group-hover:text-gold
               transition"
      >
        {tool.title}
      </h2>

      <p
        class="text-gray-600 dark:text-gray-300
               text-center text-sm leading-relaxed"
      >
        {tool.description}
      </p>

      <div
        class="mt-5 text-center text-sm font-medium
               text-blue-600 dark:text-gold
               opacity-0 group-hover:opacity-100
               transition"
      >
        Open tool →
      </div>
    </a>
  ))}
    </section>
  </main>
</BaseLayout>