---
import BaseLayout from "../../layouts/BaseLayout.astro";

// src/pages/link-qr.astro
---

<BaseLayout title="Link QR Code Generator">
    <main class="w-full max-w-md bg-white rounded-2xl shadow-xl border border-slate-100 p-6 space-y-6 mx-auto">
      <div class="text-center">
        <h1 class="text-2xl font-bold text-slate-900">Link QR Code Generator</h1>
        <p class="text-sm text-slate-500 text-xs md:text-sm">Share websites and digital resources effortlessly.</p>
        <p class="text-sm text-slate-500 text-xs md:text-sm mb-2">Connecting people to good content matters.</p>
        <p class="text-sm text-slate-500 text-xs md:text-sm mt-2">Create a QR code to share your links instantly.</p>
      </div>

      <blockquote class="text-center px-4 border-t border-slate-100 pt-4 w-full">
          <p class="text-xs text-slate-500 italic">
            "And how are they to preach unless they are sent? As it is written, “How beautiful are the feet of those who preach the good news!"
          </p>
          <cite class="block text-[10px] font-semibold uppercase tracking-wider text-slate-400 mt-1 not-italic">
            Romans 10:15
          </cite>
        </blockquote>

      <!-- Form Inputs -->
      <form id="link-form" onsubmit="return false;" class="space-y-4">
        <div>
          <label for="url" class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1">
            Website URL / Link
          </label>
          <input 
            type="url" 
            id="url" 
            placeholder="https://example.com" 
            class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm transition text-neutral-800"
          />
        </div>
      </form>

      <!-- QR Code Output Area -->
      <div class="flex flex-col items-center justify-center pt-2 space-y-4">
        <div 
          id="qr-output" 
          class="w-64 h-64 border-2 border-dashed border-slate-200 rounded-xl flex items-center justify-center p-2 bg-slate-50 transition-all"
        >
          <span class="text-xs text-slate-900 text-center px-4">
            Enter a web link above to generate a QR code
          </span>
        </div>

        <!-- Action Buttons -->
        <div class="flex items-center space-x-3 w-full max-w-xs">
          <button 
            type="button" 
            id="save-btn" 
            disabled 
            class="flex-1 flex items-center justify-center space-x-1.5 px-4 py-2 border border-slate-300 rounded-lg text-xs font-semibold text-slate-700 bg-white hover:bg-slate-50 disabled:opacity-40 disabled:cursor-not-allowed transition"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
            </svg>
            <span>Save Image</span>
          </button>

          <button 
            type="button" 
            id="share-btn" 
            disabled 
            class="flex-1 flex items-center justify-center space-x-1.5 px-4 py-2 border border-transparent rounded-lg text-xs font-semibold text-white bg-indigo-600 hover:bg-indigo-700 disabled:opacity-40 disabled:cursor-not-allowed transition"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7.217 10.907a2.25 2.25 0 100 2.186m0-2.186c.18.324.283.696.283 1.093s-.103.77-.283 1.093m0-2.186l9.566-5.314m-9.566 7.5l9.566 5.314m0 0a2.25 2.25 0 103.935 2.186 2.25 2.25 0 00-3.935-2.186zm0-12.812a2.25 2.25 0 103.933-2.185 2.25 2.25 0 00-3.933 2.185z" />
            </svg>
            <span id="share-btn-text">Share QR Code Image</span>
          </button>
        </div>

        <div>
          <p class="text-sm text-slate-500 text-center my-0 py-0">Here is a free version.</p>
          <p class="text-sm text-slate-500 text-center my-0 py-0">No Account Sign-up.</p>
          <p class="text-sm text-slate-500 text-center mt-0 py-0">Your Details are not stored on this static site.</p>
        </div>
      </div>
    </main>
</BaseLayout>

<!-- Client-Side TypeScript Script -->
<script>
  import QRCode from 'qrcode';

  const urlInput = document.getElementById('url') as HTMLInputElement | null;
  const qrOutput = document.getElementById('qr-output') as HTMLDivElement | null;
  const saveBtn = document.getElementById('save-btn') as HTMLButtonElement | null;
  const shareBtn = document.getElementById('share-btn') as HTMLButtonElement | null;
  const shareBtnText = document.getElementById('share-btn-text') as HTMLSpanElement | null;

  let currentSvgString = '';

  function setButtonsEnabled(enabled: boolean): void {
    if (saveBtn) saveBtn.disabled = !enabled;
    if (shareBtn) shareBtn.disabled = !enabled;
  }

  function formatUrl(rawUrl: string): string {
    if (!rawUrl) return '';
    if (!/^https?:\/\//i.test(rawUrl)) {
      return `https://${rawUrl}`;
    }
    return rawUrl;
  }

  function updateQR(): void {
    if (!urlInput || !qrOutput) return;

    const rawUrl = urlInput.value.trim();

    if (!rawUrl) {
      qrOutput.innerHTML = `
        <span class="text-xs text-slate-400 text-center px-4">
          Enter a web link above to generate a QR code
        </span>
      `;
      qrOutput.classList.add('border-dashed', 'bg-slate-50');
      qrOutput.classList.remove('border-solid', 'bg-white');
      currentSvgString = '';
      setButtonsEnabled(false);
      return;
    }

    const formattedUrl = formatUrl(rawUrl);

    QRCode.toString(
      formattedUrl, 
      { type: 'svg', margin: 1 }, 
      (err: Error | null | undefined, svg: string) => {
        if (!err && svg) {
          qrOutput.innerHTML = svg;
          qrOutput.classList.remove('border-dashed', 'bg-slate-50');
          qrOutput.classList.add('border-solid', 'bg-white');
          currentSvgString = svg;
          setButtonsEnabled(true);
        }
      }
    );
  }

  // Handle SVG image downloading
  saveBtn?.addEventListener('click', () => {
    if (!currentSvgString || !urlInput) return;
    
    let domain = 'link';
    try {
      const parsedUrl = new URL(formatUrl(urlInput.value.trim()));
      domain = parsedUrl.hostname.replace(/^www\./, '');
    } catch (e) {
      // Fallback filename if URL parsing fails
    }

    const blob = new Blob([currentSvgString], { type: 'image/svg+xml' });
    const url = URL.createObjectURL(blob);
    
    const a = document.createElement('a');
    a.href = url;
    a.download = `${domain.toLowerCase().replace(/[^a-z0-9]/g, '-')}-qr.svg`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  });

  // Handle native Web Share or clipboard fallback
  shareBtn?.addEventListener('click', async () => {
    if (!currentSvgString || !urlInput) return;

    const targetUrl = formatUrl(urlInput.value.trim());
    const blob = new Blob([currentSvgString], { type: 'image/svg+xml' });
    const file = new File([blob], 'link-qr.svg', { type: 'image/svg+xml' });

    if (navigator.canShare && navigator.canShare({ files: [file] })) {
      try {
        await navigator.share({
          title: `QR Code for ${targetUrl}`,
          text: `Scan to visit ${targetUrl}`,
          files: [file],
        });
      } catch (err) {
        // User cancelled share dialog
      }
    } else {
      try {
        await navigator.clipboard.writeText(window.location.href);
        if (shareBtnText) {
          const originalText = shareBtnText.textContent;
          shareBtnText.textContent = 'Copied Link!';
          setTimeout(() => {
            shareBtnText.textContent = originalText;
          }, 2000);
        }
      } catch (err) {
        alert('Sharing is not supported on this device/browser.');
      }
    }
  });

  urlInput?.addEventListener('input', updateQR);
</script>