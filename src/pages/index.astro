---
import BaseLayout from "../layouts/BaseLayout.astro";
import Bio from "../components/Bio.astro";
import Reading from "../components/Reading.astro";
import DailyVideo from "../components/DailyVideo.astro";
import DynamicDailySlideShow from "../components/DynamicDailySlideShow.astro";
import BibleDevDevotion from "../components/BibleDevDevotion.astro";
import DailyVerse from "../components/DailyVerse.astro";
import DailyQuote from "../components/DailyQuote.astro";
import { books } from "../data/books.ts";
import { me } from "../data/me.ts";
import { verses } from "../data/verses.ts";

const videos = [
  { id: "XBZ2Oigxu1g", title: "What is Prayer?", description: "Understanding the power and purpose of prayer." },
];

// Fallback safety for empty verses array
const daysSinceEpoch = Math.floor(Date.now() / 86_400_000);
const safeIndex = verses && verses.length > 0 ? daysSinceEpoch % verses.length : 0;
const todayVerse = verses?.[safeIndex] ?? { verse: "Default verse text", reference: "Genesis 1:1" };
---

<BaseLayout title={me.name}>
  <div class="max-w-6xl mx-auto pt-4 flex flex-col gap-2">

    
    <!-- Row 1: Daily Verse (4 cols) | Bio (2 cols) -->
    <div class="grid grid-cols-1 md:grid-cols-6 gap-2 w-full items-start">
      <!-- Primary (4 of 6 columns = 66.6%) -->
      <div class="hidden md:grid md:col-span-4 min-w-0 gap-2">
        <DynamicDailySlideShow todayVerse={todayVerse} />
      </div>

      <!-- Secondary (2 of 6 columns = 33.3%) -->
      <div class="col-span-1 md:col-span-2 min-w-0">
        <Bio name={me.name} role={me.role} bio={me.bio} imageSrc={me.imageSrc} />
      </div>
<div class="flex w-full md:hidden col-span-1 min-w-0">
        <BibleDevDevotion /> 
        
        <!-- <DailyVerse verse={todayVerse.verse} reference={todayVerse.reference} /> -->
      </div>
      
      <div class="md:hidden col-span-1 min-w-0">
        <DynamicDailySlideShow todayVerse={todayVerse} />
        
        <!-- <DailyVerse verse={todayVerse.verse} reference={todayVerse.reference} /> -->
      </div>

      
    </div>

    <!-- Row 2: Daily Video | Bible Dev Devotion -->
    
    <div class="grid grid-cols-1 md:grid-cols-6 gap-2 animate-fade-up [animation-delay:160ms]">
      <div class="col-span-1 md:col-span-2">
        <DailyVideo videos={videos} />
      </div>
      <div class="col-span-1 md:col-span-2">
        
        <div class="bg-card border border-border dark:border-gold/40 border-3 rounded-xl sm:rounded-lg lg:rounded-2xl overflow-hidden flex flex-col md:h-[350px]">

  <a
    href="/tools/image-quote-generator"
    class="group relative flex flex-col h-full rounded-xl
           bg-white dark:bg-card shadow-sm
           transition-all duration-300
           hover:-translate-y-2 hover:shadow-xl
           hover:border-blue-300 dark:hover:border-blue-500"
  >
  <div class="flex mb-1 mt-4 mb-1 md:mt-2">
    <p class="font-mono text-xs uppercase tracking-widest text-gold-muted mt-1 ml-4">
      Latest Picture Quote
    </p>
    <p class="md:hidden text-center text-[10px] font-medium
             text-blue-600 dark:text-gold ml-auto mr-1 mt-1">
        Create your own →
    </p>
  </div>

    <!-- Image area fills all remaining space -->
    <div class="flex-1 min-h-0">
      <img
        src="/images/quotes/quote-graphic-1790809431611.png"
        alt="Latest quote graphic"
        class="h-full w-full object-contain origin-top
               transition-transform duration-300 ease-out
               group-hover:scale-[0.9] group-focus-visible:scale-[0.9]"
      />
    </div>

    <!-- Overlaid link: out of the flow, so it doesn't shrink the image at rest -->
    <div
      class="absolute inset-x-0 bottom-3 text-center text-sm font-medium
             text-blue-600 dark:text-gold
             opacity-0 md:translate-y-2
             group-hover:opacity-100 group-hover:translate-y-0
             group-focus-visible:opacity-100 group-focus-visible:translate-y-0
             transition duration-300"
    >
      Create your own →
    </div>
  </a>
</div>
        <!-- <Reading books={books} /> -->
      </div>
      <div class="col-span-1 hidden md:flex md:col-span-2 gap-2 animate-fade-up [animation-delay:160ms]">
      <BibleDevDevotion /> 
    </div>
    </div>

    

    <footer class="mt-2 text-center font-mono text-xs text-text-muted animate-fade-up [animation-delay:240ms]">
      <p class="px-1">{me.siteInfo}</p>
      <p class="mb-12 px-1">{me.disclaimer}</p>
      Made in Love · {new Date().getFullYear()}
    </footer>

  </div>
</BaseLayout>