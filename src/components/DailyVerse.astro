---
interface Props {
  verse: string;
  reference: string;
}
const { verse, reference } = Astro.props;
const encode= (reference: string) => {
  return encodeURIComponent(reference).replace(/%20/g, '+');
}
---

<section class="bg-card border border-border dark:border-gold/40 border-3 rounded-xl sm:rounded-lg lg:rounded-2xl py-2 px-4 flex flex-col gap-4 relative overflow-hidden">

  <!-- Decorative large quote mark -->
  <span class="absolute top-3 right-5 font-serif text-7xl text-gold opacity-10 leading-none pointer-events-none select-none" aria-hidden="true">
    ❝
  </span>
  

  <div class="flex flex-col md:flex-row items-center justify-between gap-4">
    <div class="flex gap-2">
  <div>
    <p class="font-mono text-xs uppercase tracking-widest text-gold-muted">Daily Verse</p>
  </div>
  <cite class="font-mono not-italic text-xs tracking-wider text-gold">
    — {reference}
  </cite>
  </div>
  <div class="w-full md:w-auto crop-middle">
    <iframe 
      src={`https://www.esv.org/audio-player/${encode(reference)}/`} 
      style="border: 0; width: 100%; height: 109px;"
    ></iframe>
  </div>
</div>

<div class="flex flex-col md:flex-row md:items-center md:justify-between gap-2">
  
  <div>
  <blockquote class="font-serif italic text-lg leading-relaxed text-text-primary mx-6">
    "{verse}"
  </blockquote>
</div>
</div>

  

</section>

<style>
  .crop-middle {
    width: min(100%, 400px);
    height: 40px; /* 1. Set visible window height to show just the middle */
    overflow: hidden;
    position: relative;

  }

  .crop-middle iframe {
    position: absolute;
    top: -52px; /* 2. Negative value hides the TOP section */
    left: 0;
    bottom: 52px;  
    width: 100%;
    height: 109px; /* Original total iframe height */
    border: 0;
    
  }
</style>
