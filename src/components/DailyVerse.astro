---
interface Props {
  verse: string;
  reference: string;
}
const { verse, reference } = Astro.props;
---

<section class="bg-card border border-border dark:border-gold/40 border-3 rounded-xl sm:rounded-lg lg:rounded-2xl py-2 px-4 flex flex-col gap-4 relative overflow-hidden">

  <!-- Decorative large quote mark -->
  <span class="absolute top-3 right-5 font-serif text-7xl text-gold opacity-10 leading-none pointer-events-none select-none" aria-hidden="true">
    ❝
  </span>

  <div class="flex">
  <p class="font-mono text-xs uppercase tracking-widest text-gold-muted">Daily Verse</p>
  <cite class="font-mono not-italic text-xs tracking-wider text-gold">
    &nbsp;— {reference}
  </cite>
  </div>

  <blockquote class="font-serif italic text-lg leading-relaxed text-text-primary mx-6">
    "{verse}"
  </blockquote>

  

</section>
