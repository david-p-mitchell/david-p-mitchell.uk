{
  "name": "links",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev-prebuild": "npx tsx --env-file=.env ./scripts/prebuild.ts",
    "prebuild": "node scripts/fetch-playlist.js && npx tsx ./scripts/fetch-health-data.ts && npx tsx ./scripts/prebuild.ts",
    "dev": "npm run dev-prebuild && astro dev",
    "build": "npm run prebuild && astro build",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/vue": "^7.0.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "chart.js": "^4.5.1",
    "dotenv": "^18.0.7",
    "leaflet": "^1.9.4",
    "qrcode": "^1.5.4",
    "typescript": "^7.0.2",
    "vue": "^3.5.44"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@latest"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/qrcode": "^1.5.6",
    "tailwindcss": "^4.3.3"
  }
}
